---
import { ArrowRight, CalendarDays } from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import CatalogBackdrop from "../components/CatalogBackdrop.astro";
import SampleBrowser from "../components/SampleBrowser.astro";
import { getSamples, getSampleStats } from "../lib/samples";

const samples = await getSamples();
const { total, byType } = getSampleStats(samples);
---

<SiteLayout>
  <section class="catalog-intro container">
    <div>
      <p class="eyebrow">Microsoft 365 &amp; Power Platform Community</p>
      <h1>Copilot Pro Dev Samples</h1>
      <p class="catalog-intro__descriptor">Build agents. Extend Copilot. Share what works.</p>
      <p class="catalog-intro__copy">Discover community-built agents, plugins, and extensibility patterns for Microsoft 365 Copilot. Start with a real scenario, explore the code, and make it your own.</p>
    </div>
    <div class="catalog-stat" aria-label={`${total} community samples`}><strong>{total}</strong><span>community samples</span></div>
  </section>
  <aside class="community-ribbon" aria-label="Community calls">
    <div class="community-ribbon__inner container">
      <CalendarDays size={24} aria-hidden="true" />
      <p>Join the Copilot, Microsoft 365 &amp; Power Platform community calls.</p>
      <a href="https://aka.ms/community/calls">View community calls <ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </aside>
  <CatalogBackdrop>
    <SampleBrowser samples={samples} byType={byType} />
  </CatalogBackdrop>
</SiteLayout>
