---
import { ArrowRight } from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getContributors, getSamples } from "../lib/samples";
import { sitePath } from "../lib/site";
const contributors = getContributors(await getSamples());
---

<SiteLayout title="Contributors" description="Meet the community members sharing Microsoft 365 Copilot agents and extensibility samples.">
  <header class="page-heading container">
    <p class="eyebrow">Built by the community</p>
    <h1>Contributors</h1>
    <p>Meet the people sharing real-world Copilot scenarios, source code, and lessons learned. Thank you to everyone helping others build.</p>
    <a class="button button--primary" href={sitePath("/contributing/")}>Become a contributor <ArrowRight size={17} aria-hidden="true" /></a>
  </header>
  <section class="content-section content-section--tint" aria-labelledby="community-recognition-heading">
    <div class="container recognition-band">
      <img src={sitePath("/images/contributor-badge.webp")} alt="Microsoft 365 and Power Platform Community contributor badge" width="220" height="220" loading="lazy" />
      <div>
        <p class="eyebrow">Community recognition</p>
        <h2 id="community-recognition-heading">Sharing is caring</h2>
        <p>Your samples, documentation, demos, and reviews help others learn and build better Copilot experiences. The Microsoft 365 &amp; Power Platform Community celebrates the people sharing their knowledge.</p>
        <a class="text-link" href="https://aka.ms/community/recognition">Learn about community recognition <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Sharing is caring</p><h2>{contributors.length} sample contributors</h2></div></div>
      <div class="contributor-grid">
        {contributors.map((author) => (
          <article class="contributor-card">
            <span class="contributor-avatar">
              <img src={author.pictureUrl} alt="" width="72" height="72" loading="lazy" />
              <span class="contributor-avatar__fallback" aria-hidden="true" hidden>
                {author.name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join("")}
              </span>
            </span>
            <div>
              <h2>{author.name}</h2>
              <a href={`https://github.com/${author.gitHubAccount}`}>@{author.gitHubAccount}</a>
              <p>{author.samples.length} {author.samples.length === 1 ? "sample" : "samples"}</p>
              <details class="contributor-samples"><summary>View samples</summary><ul>{author.samples.map((sample) => <li><a href={sitePath(`/samples/${sample.folder}/`)}>{sample.title}</a></li>)}</ul></details>
            </div>
          </article>
        ))}
      </div>
      <p class="muted-copy">Contributors are listed from each sample's metadata. Documentation, issue reports, and reviews are also valued community contributions.</p>
    </div>
  </section>
</SiteLayout>

<script>
  for (const image of document.querySelectorAll<HTMLImageElement>(".contributor-avatar img")) {
    const showFallback = () => {
      image.hidden = true;
      image.nextElementSibling?.removeAttribute("hidden");
    };

    image.addEventListener("error", showFallback, { once: true });
    if (image.complete && image.naturalWidth === 0) showFallback();
  }
</script>
