---
import { sitePath } from "../lib/site";
const destination = sitePath("/contributing/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Contributing | Copilot Pro Dev Samples</title>
  </head>
  <body><p>This page has moved. <a href={destination}>Read the contribution guidance.</a></p></body>
</html>
