---
import { ArrowLeft, Download, ExternalLink } from "@lucide/astro";
import Avatar from "../../components/Avatar.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { renderReadme } from "../../lib/readme";
import { getSamples, type SampleEntry } from "../../lib/samples";
import { sitePath } from "../../lib/site";

interface Props {
  sample: SampleEntry;
}

export async function getStaticPaths() {
  return (await getSamples()).map((sample) => ({
    params: { folder: sample.folder },
    props: { sample },
  }));
}

const { sample } = Astro.props;
const readmeHtml = sample.readmeContent.trim() ? await renderReadme(sample.folder, sample.readmeContent) : "";
---

<SiteLayout title={sample.title} description={sample.description} image={sample.imageUrl || undefined}>
  <div class="breadcrumb container"><a href={sitePath("/")}><ArrowLeft size={17} aria-hidden="true" /> Back to samples</a></div>
  <section class="detail-hero container">
    <div>
      <p class="eyebrow">{sample.type}</p>
      <h1>{sample.title}</h1>
      <p class="detail-hero__summary">{sample.description}</p>
      <div class="detail-authors">
        {sample.authors.map((author) => (
          <a href={`https://github.com/${author.gitHubAccount}`}>
            <Avatar pictureUrl={author.pictureUrl} size={36} />{author.name}
          </a>
        ))}
      </div>
      <div class="action-row">
        <a class="button button--primary" href={sample.href} target="_blank" rel="noopener noreferrer">Open source folder <ExternalLink size={17} aria-hidden="true" /></a>
        <a class="button button--secondary" href={`https://pnp.github.io/download-partial/?url=${encodeURIComponent(sample.href)}`} target="_blank" rel="noopener noreferrer"><Download size={17} aria-hidden="true" /> Download sample</a>
      </div>
    </div>
    <figure class="detail-preview">
      <img src={sample.imageUrl || sitePath("/placeholder.webp")} alt={sample.imageAlt || `${sample.title} preview`} width="960" height="540" onerror={`this.onerror=null;this.src='${sitePath("/placeholder.webp")}';`} />
    </figure>
  </section>
  <div class="facts-band">
    <dl class="component-facts container">
      <div><dt>Sample type</dt><dd>{sample.type}</dd></div>
      <div><dt>Last updated</dt><dd>{sample.updatedAt ? <time datetime={sample.updatedAt.toISOString()}>{sample.updatedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time> : "Not specified"}</dd></div>
      <div><dt>Contributors</dt><dd>{sample.authors.length || "Community"}</dd></div>
      <div><dt>License</dt><dd>MIT</dd></div>
    </dl>
  </div>
  <section class="content-section container detail-overview">
    <h2>About this sample</h2>
    <div class="prose-lead">{(sample.longDescription.length ? sample.longDescription : [sample.description]).map((line) => <p>{line}</p>)}</div>
    {sample.metadata.length > 0 && <dl class="sample-metadata">{sample.metadata.map((item) => <div><dt>{item.key}</dt><dd>{item.value}</dd></div>)}</dl>}
  </section>
  <section class="content-section container detail-documentation">
    <div class="section-heading"><div><p class="eyebrow">Setup and usage</p><h2>Sample documentation</h2></div></div>
    {readmeHtml
      ? <article class="readme-content" set:html={readmeHtml}></article>
      : <p>Documentation is not available in the catalog. <a href={sample.href}>Check the sample source folder</a> for setup guidance.</p>}
  </section>
</SiteLayout>
