---
import { sitePath } from "../lib/site";
const destination = sitePath("/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Copilot Pro Dev Samples</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(`${destination}${window.location.search}${window.location.hash}`);
    </script>
  </head>
  <body><p>This page has moved. <a href={destination}>Browse the samples on the home page.</a></p></body>
</html>
