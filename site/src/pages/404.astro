---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../lib/site";
---

<SiteLayout title="Page not found" description="This page may have moved. Explore Microsoft 365 Copilot community samples instead.">
  <section class="not-found container">
    <p class="eyebrow">404</p>
    <h1>That page is not in the gallery.</h1>
    <p>The link may be out of date, or the page may have moved.</p>
    <div class="action-row">
      <a class="button button--primary" href={sitePath("/")}>Back to home</a>
      <a class="button button--secondary" href={sitePath("/samples/")}>Browse samples</a>
    </div>
  </section>
</SiteLayout>
