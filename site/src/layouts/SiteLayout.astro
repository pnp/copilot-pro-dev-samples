---
import { ArrowUpRight, GitFork, Menu, Moon, Sun } from "@lucide/astro";
import ContributionCallout from "../components/ContributionCallout.astro";
import { repositoryUrl, sitePath, visitorStatsUrl } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Copilot Pro Dev Samples",
  description = "Community-built agents, plugins, and extensibility samples for Microsoft 365 Copilot.",
  image = sitePath("/images/copilot.png"),
} = Astro.props;
const pageTitle = title === "Copilot Pro Dev Samples" ? title : `${title} | Copilot Pro Dev Samples`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;
const navigation = [
  { label: "Samples", href: "/" },
  { label: "Getting started", href: "/getting-started/" },
  { label: "Contributors", href: "/contributors/" },
  { label: "Contributing", href: "/contributing/" },
  { label: "What's new", href: "/whats-new/" },
];
const isCurrent = (href: string) => href === "/"
  ? currentPath === sitePath("/") || currentPath.startsWith(sitePath("/samples/"))
  : currentPath.startsWith(sitePath(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta id="theme-color" name="theme-color" content="#f1f2f4" />
    <script is:inline>
      (() => {
        let theme = "light";
        try {
          if (localStorage.getItem("site-theme") === "dark") theme = "dark";
        } catch (error) {
          console.warn("Theme preference is unavailable; using light mode.", error);
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="icon" type="image/png" href={sitePath("/images/copilot.png")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Copilot Pro Dev Samples" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script src="../scripts/clarity.ts"></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="spectrum" aria-hidden="true"></div>
      <div class="site-header__inner container">
        <a class="brand" href={sitePath("/")} aria-label="Copilot Pro Dev Samples home">
          <img src={sitePath("/images/copilot.png")} alt="" width="38" height="38" />
          <span>Copilot <strong>Pro Dev Samples</strong></span>
        </a>
        <div class="site-header__actions">
          <nav class="desktop-nav" aria-label="Primary navigation">
            <a href="https://aka.ms/community/home">Community <ArrowUpRight size={12} aria-hidden="true" /></a>
            {navigation.map((item) => (
              <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
            <a class="nav-github" href={repositoryUrl}><GitFork size={18} aria-hidden="true" /> GitHub</a>
          </nav>
          <button class="theme-toggle" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Switch to dark mode" title="Switch to dark mode">
            <span class="theme-toggle__icons" aria-hidden="true">
              <Sun class="theme-toggle__sun" size={16} />
              <Moon class="theme-toggle__moon" size={15} />
            </span>
          </button>
          <details class="mobile-nav">
            <summary title="Open navigation" aria-label="Open navigation"><Menu size={22} /></summary>
            <nav aria-label="Mobile navigation">
              <a href="https://aka.ms/community/home">Community <ArrowUpRight size={12} aria-hidden="true" /></a>
              {navigation.map((item) => (
                <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
              ))}
              <a href={repositoryUrl}>GitHub</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <ContributionCallout />
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <strong>Microsoft 365 &amp; Power Platform Community</strong>
          <p>Built by the community, for the community.</p>
          <p class="site-disclaimer">Samples are provided as is, without warranty, under the MIT license.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="https://aka.ms/community/home">Community home</a>
          <a href={sitePath("/samples.json")}>Catalog JSON</a>
          <a href={`${repositoryUrl}/issues/new`}>Report an issue</a>
          <a href={`${repositoryUrl}/security/policy`}>Security</a>
          <a href={`${repositoryUrl}/blob/main/CODE_OF_CONDUCT.md`}>Code of conduct</a>
          <a href={`${repositoryUrl}/blob/main/LICENSE`}>MIT license</a>
        </nav>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");

      function applyTheme(theme: "light" | "dark", persist = false) {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        const label = `Switch to ${theme === "dark" ? "light" : "dark"} mode`;
        toggle?.setAttribute("aria-checked", String(theme === "dark"));
        toggle?.setAttribute("aria-label", label);
        if (toggle) toggle.title = label;
        if (themeColor) themeColor.content = theme === "dark" ? "#0c111a" : "#f1f2f4";
        if (persist) {
          try {
            localStorage.setItem("site-theme", theme);
          } catch (error) {
            console.warn("Theme changed, but the preference could not be saved.", error);
          }
        }
      }

      applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
      toggle?.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
      });
    </script>
    <img class="sr-only" data-visitor-stats src={visitorStatsUrl(currentPath)} alt="" width="1" height="1" aria-hidden="true" />
  </body>
</html>
