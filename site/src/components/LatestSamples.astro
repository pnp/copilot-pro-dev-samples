---
import type { SampleEntry } from "../lib/samples";

interface Props {
  samples: SampleEntry[];
  count: number;
}

const { samples, count } = Astro.props;
---

<section class="space-y-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="space-y-2">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Recently updated samples</h2>
      <p class="max-w-2xl text-sm leading-relaxed text-slate-300">
        Start here if you want a quick read on the newest additions and actively maintained examples in the catalog.
      </p>
    </div>
    <a class="chip-button" href="/samples">View Full Catalog</a>
  </div>

  {
    samples.length > 0 ? (
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {samples.map((sample) => (
          <a href={`/samples/${sample.folder}`} class="sample-card-shell theme-card-hover flex flex-col gap-4 p-5 transition hover:-translate-y-0.5">
            <div class="flex h-9 shrink-0 items-center justify-between gap-3">
              <div class="sample-type-pill" data-sample-type={sample.type}>{sample.type}</div>
              <div class="sample-date-pill shrink-0">
                {sample.updatedAt ? sample.updatedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "Date unknown"}
              </div>
            </div>
            <div class="sample-card-image">
              <img
                src={sample.imageUrl || "/placeholder.webp"}
                alt={sample.imageAlt.trim().length > 0 ? sample.imageAlt : `${sample.title} preview`}
                loading="lazy"
                onerror="this.onerror=null;this.src='/placeholder.webp';"
              />
            </div>
            <div class="space-y-3">
              <h3 class="sample-card-title">{sample.title}</h3>
              <p class="sample-card-description">{sample.description}</p>
            </div>
            {sample.authors[0] && (
              <div class="sample-card-author">
                <img src={sample.authors[0].pictureUrl} alt="" aria-hidden="true" />
                <span>{sample.authors[0].name}</span>
              </div>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="frost-panel border border-dashed border-white/30 p-4 text-sm text-slate-300">
        No samples are available.
      </div>
    )
  }
</section>