---
import { ArrowRight, Search } from "@lucide/astro";
import SampleCard from "./SampleCard.astro";
import type { SampleEntry } from "../lib/samples";
import { sitePath } from "../lib/site";

interface Props {
  samples: SampleEntry[];
  byType: Record<string, number>;
}

const { samples, byType } = Astro.props;
const sortedTypes = Object.keys(byType).sort((a, b) => a.localeCompare(b));
const sortedSamples = [...samples].sort((a, b) =>
  (b.updatedAt?.getTime() ?? 0) - (a.updatedAt?.getTime() ?? 0) || a.title.localeCompare(b.title),
);
---

<section id="browse" class="catalog-shell container" aria-labelledby="catalog-heading">
  <div class="section-heading">
    <div><p class="eyebrow">Sample catalog</p><h2 id="catalog-heading">Explore Copilot samples</h2></div>
    <a class="text-link" href={sitePath("/getting-started/")}>How to use a sample <ArrowRight size={17} aria-hidden="true" /></a>
  </div>
  <div class="catalog-toolbar">
    <div class="search-control">
      <Search size={19} aria-hidden="true" />
      <label class="sr-only" for="sample-search">Search samples</label>
      <input id="sample-search" type="search" placeholder="Search by title, folder, or description" autocomplete="off" aria-describedby="active-summary" />
    </div>
    <label class="sr-only" for="sample-type">Sample type</label>
    <select id="sample-type">
      <option value="all">All sample types</option>
      {sortedTypes.map((type) => <option value={type}>{type} ({byType[type]})</option>)}
    </select>
    <button type="button" id="clear-filters" class="button button--secondary">Clear filters</button>
  </div>
  <p class="result-count" id="active-summary" aria-live="polite">Showing {samples.length} samples</p>
  <div id="samples-grid" class="component-grid">
    {sortedSamples.map((sample, index) => <SampleCard sample={sample} index={index} />)}
  </div>
  <div id="empty-state" class="empty-state" hidden>
    <Search size={28} aria-hidden="true" />
    <h3>No samples found</h3>
    <p>Try a broader search or choose a different sample type.</p>
    <button class="button button--secondary" type="button" id="empty-clear">Clear filters</button>
  </div>
</section>

<script>
  import { initSampleBrowser } from "../scripts/sample-browser";
  initSampleBrowser();
</script>
